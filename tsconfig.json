{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node"
  },
  "include": ["src/cli/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "src/electron/**/*",
    "src/cli/commands/assist.ts",
    "src/cli/commands/bluetooth.ts",
    "src/cli/commands/dashboard.ts",
    "src/cli/commands/detect.ts",
    "src/cli/commands/diagnostics.ts",
    "src/cli/commands/export.ts",
    "src/cli/commands/import.ts",
    "src/cli/commands/motor.ts",
    "src/cli/commands/profile.ts",
    "src/cli/commands/read.ts",
    "src/cli/commands/remote.ts",
    "src/cli/commands/security.ts",
    "src/cli/commands/smart.ts",
    "src/cli/commands/speed.ts",
    "src/cli/commands/update.ts",
    "src/cli/commands/write.ts"
  ]
}
